#!/usr/bin/env bash
# Runs orchestra.mjs next to the real script, even when this file is reached through a symlink.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do dir="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ "$src" != /* ]] && src="$dir/$src"; done
exec node "$(cd "$(dirname "$src")" && pwd)/orchestra.mjs" "$@"
